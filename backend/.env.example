PORT=4000
NODE_ENV=development

# DynamoDB (real AWS, not an emulator). Credentials come from the AWS CLI's
# shared config/credentials file via AWS_PROFILE - set this to whichever
# profile points at the AWS account these tables should live in.
AWS_PROFILE=friend
AWS_REGION=ap-south-1

# Table suffix: keeps local development (dev) from touching the deployed
# app's data (prod), even though both point at the same AWS account.
TABLE_ENV=dev

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
